# ==========================================================================
# QWYTHOS Telegram Bot — environment template
# ==========================================================================
# Copy to .env for LOCAL runs:   cp .env.example .env
# For Coolify: paste these as Environment Variables in the Coolify UI.
# NEVER commit the real .env (it is already in .gitignore).
# ==========================================================================

# --- Required -------------------------------------------------------------

# From @BotFather → /newbot (or /mybots → API Token)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Groq free-tier key → https://console.groq.com/keys
GROQ_API_KEY=gsk_exampleReplaceMe

# Public https URL of the deployed service (no trailing slash).
# Coolify: use the domain you attached, e.g. https://qwythos-bot.example.com
# Local (no public URL): leave empty and run app.py (long-polling) instead.
WEBHOOK_BASE_URL=https://qwythos-bot.example.com

# --- Optional -------------------------------------------------------------

# Random secret; Telegram signs each webhook POST with it (recommended).
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Port the container listens on (Coolify/Traefik proxy target).
PORT=8080

# Path to the SQLite memory file (set when using a persistent volume).
# MEMORY_DB=/app/data/memory.db
